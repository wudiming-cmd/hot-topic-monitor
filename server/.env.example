# 复制为 .env 并填写
PORT=8787

# Reddit 官方 API(可选,但强烈建议)。不填则回退到公开 .json(限流更严)。
# 申请:https://www.reddit.com/prefs/apps → create app → 选 "script"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=hot-topic-monitor/0.1 by your_reddit_username

# 综合分权重(可选,默认 0.5/0.3/0.2)
WEIGHT_VELOCITY=0.5
WEIGHT_POPULARITY=0.3
WEIGHT_ENGAGEMENT=0.2

# Meta 广告资料库(可选,/ads 需要)
META_ADLIB_TOKEN=

# Giphy(可选):配置后实时监控的"梗图"分类会有真实 trending GIF + 预览图
# 免费申请:https://developers.giphy.com/
GIPHY_API_KEY=

# 无头浏览器源(TikTok Creative Center / Pinterest Today):重且慢,默认关。
# 开启需先:cd server && npm i -D playwright && npx playwright install chromium
ENABLE_HEADLESS=false

# TMDb 娱乐(影视热点):免费 key。https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# YouTube 热门视频:免费配额。Google Cloud Console 启用 YouTube Data API v3 后创建 key
YOUTUBE_API_KEY=
YOUTUBE_REGION=US

# DeepSeek AI 分析(/analyze 需要)。Key 只放这里,绝不进前端。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 允许的前端来源(CORS),逗号分隔;默认 * 放开
CORS_ORIGIN=*

# 定时采集间隔(分钟)。>0 则后端周期性采集并写入历史快照,
# 让 velocity(上升速度)/状态追踪/月度汇总随天数变真实。0=关闭(仅按请求采集)。
COLLECT_INTERVAL_MIN=0
